{
  "tree_of": "town.tree_of($1::integer)",
  "tree_kind": "town.tree_kind(town.tree_of($1::integer))",
  "tree_bears": "town.tree_bears(town.tree_of($1::integer))",
  "tree_most": "town.tree_most(town.tree_of($1::integer))",
  "tree_far": "town.tree_far(town.tree_of($1::integer), $2::integer, $3::integer)",
  "tree_until": "town.tree_until($1::boolean, $2::bigint)",
  "tree_grown": "town.tree_grown($1::jsonb, town.tree_of($2::integer), $3::bigint)",
  "axe_of": "town.axe_of($1::jsonb)",
  "axe_bites": "town.axe_bites($1::jsonb, town.tree_of($2::integer))",
  "axe_chops": "town.axe_chops($1::jsonb, $2::double precision)",
  "axe_ahead": "town.axe_ahead($1::jsonb)",
  "axe_pace": "town.axe_pace($1::jsonb)",
  "fell_chops": "town.fell_chops($1::jsonb, town.tree_of($2::integer), $3::boolean)",
  "tree_held": "town.tree_held($1::jsonb, $2::integer, $3::bigint, $4::text)",
  "fell_opened": "town.fell_opened($1::jsonb, $2::text, $3::jsonb, $4::bigint)",
  "brace_go": "town.brace_go($1::jsonb, $2::text, $3::text, $4::integer, $5::integer, $6::bigint)",
  "brace_pay": "town.brace_pay($1::jsonb)",
  "keepsake_ids": "town.keepsake_ids()",
  "keepsakes_of": "town.keepsakes_of($1::integer)",
  "keepsake_for": "town.keepsake_for(town.tree_of($1::integer), $2::double precision, $3::double precision)",
  "felling_of": "town.felling_of($1::jsonb)",
  "timber_of": "town.timber_of($1::jsonb, $2::numeric)",
  "grove_tidied": "town.grove_tidied($1::jsonb, $2::bigint)",
  "trees_told": "town.trees_told($1::jsonb, $2::jsonb, $3::bigint)",
  "fell_group": "(select jsonb_agg((g.v->>0)::integer order by g.ord) from jsonb_array_elements(town.fell_group($1::jsonb, $2::jsonb, town.tree_of($3::integer), $4::jsonb, $5::bigint, $6::text)) with ordinality g(v, ord))",
  "fell_most": "town.fell_most($1::jsonb, (select jsonb_agg(town.tree_of(i.v::integer) order by i.ord) from jsonb_array_elements_text($2::jsonb) with ordinality i(v, ord)))",
  "fell_begin": "town.fell_begin($1::jsonb, $2::jsonb, $3::integer, $4::integer, $5::integer, $6::bigint, $7::bigint, $8::text)",
  "fell": "town.fell($1::jsonb, $2::jsonb, $3::text, $4::jsonb, $5::integer, $6::integer, $7::bigint, $8::jsonb, $9::text)",
  "fell_root": "town.fell_root($1::jsonb, $2::jsonb, $3::text, $4::integer, $5::bigint)",
  "counts_of": "town.work_counts_of($1::jsonb, $2::text)"
}
